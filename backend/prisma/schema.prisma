// Prisma Schema v5 - Service Booking Platform
// ============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================

enum UserRole {
  USER
  ORGANIZER
  ADMIN
}

enum SlotStatus {
  AVAILABLE
  HOLD
  BOOKED
}

enum PaymentMode {
  ONLINE
  CASH
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum OtpType {
  VERIFICATION
  PASSWORD_RESET
}

// ============================================
// MODELS
// ============================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String    // bcrypt hashed
  name          String
  phone         String?
  role          UserRole  @default(USER)
  verified      Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  otps          Otp[]
  services      Service[]    @relation("OrganizerServices")
  bookings      Booking[]

  @@index([email])
  @@index([role])
}

model Otp {
  id        String   @id @default(cuid())
  code      String   // 6-digit OTP
  type      OtpType  @default(VERIFICATION)
  expiresAt DateTime
  userId    String
  createdAt DateTime @default(now())

  // Relations
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([type])
}

model Service {
  id           String   @id @default(cuid())
  title        String
  description  String
  category     String
  price        Float    // INR, up to 2 decimals
  imageUrl     String?
  published    Boolean  @default(false)
  organizerId  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Location
  address      String?
  city         String?
  state        String?
  latitude     Float?
  longitude    Float?

  // Relations
  organizer    User              @relation("OrganizerServices", fields: [organizerId], references: [id], onDelete: Cascade)
  schedules    ServiceSchedule[]
  slots        Slot[]
  bookings     Booking[]

  @@index([organizerId])
  @@index([published])
  @@index([category])
}

model ServiceSchedule {
  id            String   @id @default(cuid())
  serviceId     String
  startDate     DateTime // Service start date
  endDate       DateTime // Service end date
  startTime     String   // HH:mm format (e.g., "09:00")
  endTime       String   // HH:mm format (e.g., "18:00")
  slotDuration  Int      // Duration in minutes
  breakHours    Json?    // Array of break periods: [{start: "12:00", end: "13:00"}]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  service       Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
}

model Slot {
  id          String     @id @default(cuid())
  serviceId   String
  date        DateTime   // Date of the slot (DATE only, no time)
  startTime   String     // HH:mm format
  endTime     String     // HH:mm format
  status      SlotStatus @default(AVAILABLE)
  holdExpiry  DateTime?  // When HOLD status expires
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Relations
  service     Service    @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  booking     Booking?

  @@unique([serviceId, date, startTime])
  @@index([serviceId])
  @@index([date])
  @@index([status])
  @@index([holdExpiry])
}

model Booking {
  id            String        @id @default(cuid())
  userId        String
  serviceId     String
  slotId        String        @unique
  paymentMode   PaymentMode
  paymentStatus PaymentStatus
  transactionId String?       // PhonePe transaction ID
  amount        Float         // INR
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relations
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  service       Service       @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  slot          Slot          @relation(fields: [slotId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([serviceId])
  @@index([slotId])
  @@index([paymentStatus])
}
